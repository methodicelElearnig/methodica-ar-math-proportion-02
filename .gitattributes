# Line endings, pinned so every clone agrees (same policy as methodica-math-proportion-01).
# Every text blob in the index is already LF (`git ls-files --eol`), so this renormalises
# nothing; it also pins the working tree to LF on Windows, so packages copied from any
# machine are byte-identical (guide §11.1).

* text=auto eol=lf

*.woff2 binary
*.ttf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.mp4   binary
*.pptx  binary
*.docx  binary
*.pdf   binary

*.svg   text eol=lf
